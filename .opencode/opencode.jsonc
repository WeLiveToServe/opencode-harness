{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen/qwen3.6-plus",
  "small_model": "openrouter/qwen/qwen3.6-plus",
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "qwen/qwen3.6-plus": {
          "id": "qwen/qwen3.6-plus",
          "name": "Qwen 3.6 Plus (1M)",
          "family": "qwen",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        }
      }
    },
    "nvidia-direct": {
      "name": "NVIDIA NIM Hosted",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "llama-3.1-8b-instruct": {
          "id": "meta/llama-3.1-8b-instruct",
          "name": "Llama 3.1 8B Instruct (NVIDIA)",
          "family": "llama",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 4096
          }
        },
        "nemotron-3-super-120b-a12b": {
          "id": "nvidia/nemotron-3-super-120b-a12b",
          "name": "Nemotron 3 Super 120B A12B (NVIDIA)",
          "family": "nemotron",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    },
    "modal-h100": {
      "name": "Modal H100 vLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OPENCODE_MODAL_BASE_URL}",
        "apiKey": "{env:OPENCODE_MODAL_API_KEY}"
      },
      "models": {
        "qwen3-8b": {
          "id": "{env:OPENCODE_MODAL_MODEL}",
          "name": "Qwen3 8B (Modal H100)",
          "family": "qwen",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
